generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model anuncio {
  id                            Int                             @id @default(autoincrement())
  titulo                        String?                         @db.VarChar(50)
  descricao                     String?                         @db.VarChar(500)
  quartos                       Int
  camas                         Int
  banheiros                     Int
  hospedes                      Int
  cameras                       Boolean
  valor_diaria                  Decimal                        @db.Decimal
  dias_minimo_antecedencia      Int                            @default(0)
  dias_minimo_duracao           Int                            @default(0)
  dias_maximo_duracao           Int                            @default(0)
  publicado                     Boolean                        @default(false)
  tipo_reserva_atual            tipo_reserva
  data_checkin                  DateTime?                        
  data_checkout                 DateTime?                        
  regra_da_casa                 String?                          @db.VarChar(100)
  politica_cancelamento         String?                          @db.VarChar(100)
  anfitriao                     Int
  tipo_imovel_id                Int       
  tipo_espaco_id                Int
  tipo_hospede_id               Int
  seguranca_id                  Int?

  usuario                       usuario                         @relation(fields: [anfitriao], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_anfitriao")
  tipo_imovel                   tipo_imovel                     @relation(fields: [tipo_imovel_id], references: [id])
  tipo_espaco                   tipo_espaco                     @relation(fields: [tipo_espaco_id], references: [id])
  seguranca                     seguranca?                      @relation(fields: [seguranca_id], references: [id])
  tipo_hospede                  tipo_hospede                    @relation(fields: [tipo_hospede_id], references: [id])

  endereco                      endereco[]
  favoritos                     favoritos[]
  lista_favoritos_personalizada lista_favoritos_personalizada[]
  reserva                       reserva[]
  anuncioComodidades            anuncioComodidades[]
  anuncioFotos                  anuncioFotos[]
}

model fotos {
  id                            Int       @id @default(autoincrement())
  url                           String    @db.VarChar(255)

  anuncioFotos                  anuncioFotos[]
}

model anuncioFotos {
  anuncio_id    Int
  foto_id Int

  anuncio       anuncio    @relation(fields: [anuncio_id], references: [id], map: "fk_anuncio_fotos_anuncio")
  fotos         fotos      @relation(fields: [foto_id], references: [id], map: "fk_anuncio_fotos_foto")

  @@id([anuncio_id, foto_id])
  @@map("anuncio_fotos")  
}

model comodidades {
  id                  Int       @id @default(autoincrement())
  comodidade          String    @db.VarChar(50)
  icone               String?   @db.VarChar(50)
  especial            Boolean   @default(false)

  anuncioComodidades  anuncioComodidades[]   
}

model anuncioComodidades {
  anuncio_id    Int
  comodidade_id Int

  anuncio       anuncio    @relation(fields: [anuncio_id], references: [id], map: "fk_anuncio_comodidades_anuncio")
  comodidade    comodidades @relation(fields: [comodidade_id], references: [id], map: "fk_anuncio_comodidades_comodidade")

  @@id([anuncio_id, comodidade_id])
  @@map("anuncio_comodidades") 
}

model tipo_imovel {
  id                  Int       @id @default(autoincrement())
  imovel              String    @db.VarChar(50)
  icone               String?    @db.VarChar(50)

  anuncio             anuncio[]          
}

model tipo_espaco {
  id                  Int       @id @default(autoincrement())
  espaco              String    @db.VarChar(50)
  icone               String?    @db.VarChar(50)

  anuncio             anuncio[]          
}

model seguranca {
  id                  Int       @id @default(autoincrement())
  item_seguranca      String    @db.VarChar(50)

  anuncio             anuncio[]          
}

model tipo_hospede {
  id                  Int       @id @default(autoincrement())
  hospede             String    @db.VarChar(50)
  icone               String?    @db.VarChar(50)

  anuncio             anuncio[]          
}

model avaliacao {
  id                                              Int       @id @default(autoincrement())
  id_usuario_avaliador                            Int
  id_usuario_avaliado                             Int?
  id_anuncio_avaliado                             Int?
  nota_limpeza                                    Decimal?  @db.Decimal @default(0)
  nota_exatidao_anuncio                           Decimal?  @db.Decimal @default(0)
  nota_custo_beneficio                            Decimal?  @db.Decimal @default(0)
  nota_localizacao                                Decimal?  @db.Decimal @default(0)
  comentario                                      String    @db.VarChar(255) 
  nota_seguiu_regras                              Decimal?  @db.Decimal @default(0)
  nota_pontualidade                               Decimal?  @db.Decimal @default(0)
  nota_cordialidade                               Decimal?  @db.Decimal @default(0)
  criado_em                                       DateTime? @default(now()) 
  usuario_avaliacao_id_usuario_avaliadoTousuario  usuario?  @relation("avaliacao_id_usuario_avaliadoTousuario", fields: [id_usuario_avaliado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_avaliado")
  usuario_avaliacao_id_usuario_avaliadorTousuario usuario   @relation("avaliacao_id_usuario_avaliadorTousuario", fields: [id_usuario_avaliador], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_avaliador")
  usuario_usuario_avaliacao_idToavaliacao         usuario[] @relation("usuario_avaliacao_idToavaliacao")
}

model endereco {
  id          Int       @id @default(autoincrement())
  id_usuario  Int?
  id_anuncio  Int?
  cep         String    @db.VarChar(10)
  estado      String    @db.VarChar(2)
  cidade      String    @db.VarChar(50)
  bairro      String    @db.VarChar(50)
  rua         String    @db.VarChar(100)
  numero      String?   @db.VarChar(4)
  complemento String?   @db.VarChar(255)
  latitude    String?   @db.VarChar(50)
  longitude   String?   @db.VarChar(50)
  criado_em   DateTime? @default(now()) 
  anuncio     anuncio?  @relation(fields: [id_anuncio], references: [id])
  usuario     usuario?  @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model favoritos {
  id         Int       @id @default(autoincrement())
  id_usuario Int?
  id_anuncio Int?
  criado_em  DateTime? @default(now()) 
  anuncio    anuncio?  @relation(fields: [id_anuncio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario    usuario?  @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model usuario {
  id                                                Int                             @id @default(autoincrement())
  foto                                              String?                         @db.VarChar(255)
  nome                                              String                          @db.VarChar(50)
  nome_completo                                     String?                         @db.VarChar(150)
  email                                             String                          @unique @db.VarChar(100)
  cpf                                               String?                         @db.VarChar(14)
  telefone                                          String?                         @db.VarChar(14)
  admin                                             Boolean?                        @default(false)
  criado_em                                         DateTime?                       @default(now()) 
  ativo                                             Boolean?                        @default(true)
  url_documento                                     String?                         @db.VarChar(255)
  bloqueado                                         Boolean?                        @default(false)
  token_acesso                                      String                          @db.VarChar(255)
  avaliacao_id                                      Int?
  anuncio                                           anuncio[]
  notificacao                                       notificacao[] 
  avaliacao_avaliacao_id_usuario_avaliadoTousuario  avaliacao[]                     @relation("avaliacao_id_usuario_avaliadoTousuario")
  avaliacao_avaliacao_id_usuario_avaliadorTousuario avaliacao[]                     @relation("avaliacao_id_usuario_avaliadorTousuario")
  dados_bancarios                                   dados_bancarios[]
  endereco                                          endereco[]
  favoritos                                         favoritos[]
  lista_favoritos_personalizada                     lista_favoritos_personalizada[]
  reserva                                           reserva[]
  avaliacao_usuario_avaliacao_idToavaliacao         avaliacao?                      @relation("usuario_avaliacao_idToavaliacao", fields: [avaliacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_avaliacao")
}

model dados_bancarios {
  id           Int     @id @default(autoincrement())
  id_usuario   Int
  banco        String  @db.VarChar(50)
  agencia      String  @db.VarChar(50)
  numero_conta String  @db.VarChar(20)
  tipo_conta   String  @db.VarChar(15)
  chave_pix    String? @db.VarChar(50)
  usuario      usuario @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model lista_favoritos_personalizada {
  id         Int       @id @default(autoincrement())
  id_usuario Int?
  id_anuncio Int?
  nome       String?   @db.VarChar(20)
  criado_em  DateTime? @default(now()) 
  anuncio    anuncio?  @relation(fields: [id_anuncio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario    usuario?  @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reserva {
  id               Int               @id @default(autoincrement())
  id_usuario       Int?
  id_anuncio       Int?
  qtd_adultos      Int?
  qtd_criancas     Int?
  qtd_bebes        Int?
  qtd_pets         Int?
  data_inicial     DateTime?         
  data_final       DateTime?    
  prazo_cancelamento DateTime              @db.Date     
  status_reserva   status_reserva?
  status_pagamento status_pagamento?
  status_aceite    status_aceite_reserva @default(Aguardando_resposta_anfitiao)
  notificacao      notificacao[]
  multa            Boolean?          @default(false)
  cancelamento     Boolean?          @default(false)
  criado_em        DateTime?         @default(now()) 
  anuncio          anuncio?          @relation(fields: [id_anuncio], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_anuncio")
  usuario          usuario?          @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario")
}

enum status_pagamento {
  Conclu_do  @map("Concluído")
  Aguardando
}

enum status_reserva {
  Reservado
  Processando
}

enum tipo_reserva {
  Instant_nea     @map("Instantânea")
  N_o_instant_nea @map("Não instantânea")
}

model notificacao {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  reserva_id Int? 
  tipo       String   @db.VarChar(50) 
  mensagem   String   @db.VarChar(255) 
  status     String   @db.VarChar(20) 
  data_envio DateTime @default(now()) 

  usuario usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  reserva reserva? @relation(fields: [reserva_id], references: [id])

  @@index([usuario_id])
}

enum status_aceite_reserva {
  Aceita
  Negada
  Aguardando_resposta_anfitiao @map("Aguardando resposta")
}